# Copy to .env — read by docker-compose.yml for local infra only.
# Each app (apps/api, apps/admin) keeps its own .env for app-level config;
# see apps/api/.env.example.

DB_DATABASE=giftbuddy
DB_USERNAME=giftbuddy
DB_PASSWORD=giftbuddy
DB_ROOT_PASSWORD=giftbuddy_root
# 3307, not 3306 — leaves room for another local MySQL/container already on the default port
DB_PORT=3307

REDIS_PORT=6379

MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
