# Copy to .env.local for local development.

NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Leave blank while the API's STRIPE_SECRET_KEY is also blank — checkout then
# uses the dev payment simulator and skips Stripe Elements entirely. Set this
# to a Stripe test-mode publishable key once the API has a matching secret key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Same Web application OAuth client as apps/api's GOOGLE_CLIENT_ID. Add this
# site's origin (e.g. http://localhost:3000) under "Authorized JavaScript
# origins" on that client at https://console.cloud.google.com/apis/credentials —
# unlike apps/mobile's redirect-based flow, the Identity Services button
# authenticates via origin, not a redirect URI. Leave blank to hide the
# "Continue with Google" button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# GA4 Measurement ID (looks like G-XXXXXXXXXX) from a property created at
# https://analytics.google.com — Admin > Data Streams > (your web stream).
# Tracks every visitor, not just signed-in ones. Leave blank to disable
# analytics entirely (no script loads, nothing sent to Google).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Origin of the deployed admin app, proxied at this site's /admin path (see
# next.config.ts rewrites). Leave unset for local dev — defaults to
# http://localhost:3002, where `npm run dev:admin` listens.
ADMIN_APP_URL=
