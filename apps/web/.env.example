# Copy to .env.local for local development.

NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Leave blank while the API's STRIPE_SECRET_KEY is also blank — checkout then
# uses the dev payment simulator and skips Stripe Elements entirely. Set this
# to a Stripe test-mode publishable key once the API has a matching secret key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
