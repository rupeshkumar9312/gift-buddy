# Copy to .env.local for local development.
# Expo inlines any EXPO_PUBLIC_-prefixed var into the JS bundle at build time.

# iOS simulator and web can reach the API host machine via localhost.
# Android emulator cannot — use http://10.0.2.2:3001/api/v1 instead.
# A physical device needs your machine's LAN IP, e.g. http://192.168.1.x:3001/api/v1.
EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1
