# Copy to .env.local for local development.
# Expo inlines any EXPO_PUBLIC_-prefixed var into the JS bundle at build time.

# iOS simulator and web can reach the API host machine via localhost.
# Android emulator cannot — use http://10.0.2.2:3001/api/v1 instead.
# A physical device needs your machine's LAN IP, e.g. http://192.168.1.x:3001/api/v1.
EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1

# The Web application OAuth Client ID from
# https://console.cloud.google.com/apis/credentials — same value as
# apps/api's GOOGLE_CLIENT_ID, since that's the audience the API verifies
# the token against. Passed to GoogleSignin.configure({ webClientId }) —
# this is NOT the separate Android-type client (package name + SHA-1) that
# also needs to exist in the same project for Play Services to allow the
# native sign-in on this app; that one has no client ID to set here.
# Leave blank to disable the button (it'll show a clear error instead of a
# broken flow). Requires a custom development build — native Google Sign In
# needs Play Services, which Expo Go does not provide.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
