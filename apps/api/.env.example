# Copy to .env and fill in for local development.
# apps/api validates these on boot — see src/config/env.validation.ts

NODE_ENV=development
PORT=3001

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Matches docker-compose.yml's mysql service (host port 3307 to avoid clashing
# with any other local MySQL already on the 3306 default)
DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=giftbuddy
DB_PASSWORD=giftbuddy
DB_DATABASE=giftbuddy

# Generate real secrets before anything but local dev, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
