# Copy to .env and fill in for local development.
# apps/api validates these on boot — see src/config/env.validation.ts

NODE_ENV=development
PORT=3001

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Matches docker-compose.yml's mysql service (host port 3307 to avoid clashing
# with any other local MySQL already on the 3306 default)
DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=giftbuddy
DB_PASSWORD=giftbuddy
DB_DATABASE=giftbuddy

# Generate real secrets before anything but local dev, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# Separate signing secrets for the admin console — never share these with
# JWT_ACCESS_SECRET/JWT_REFRESH_SECRET above.
ADMIN_JWT_ACCESS_SECRET=dev-admin-access-secret-change-me
ADMIN_JWT_REFRESH_SECRET=dev-admin-refresh-secret-change-me

# Leave blank to use the built-in dev payment simulator (no Stripe account needed).
# Fill in real Stripe test-mode keys (https://dashboard.stripe.com/test/apikeys)
# to exercise the actual Stripe API; STRIPE_WEBHOOK_SECRET comes from
# `stripe listen --forward-to localhost:3001/api/v1/webhooks/stripe` in dev.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=dev-webhook-secret-change-me
STRIPE_PUBLISHABLE_KEY=

# 'true' routes checkout through Stripe (or its dev simulator above);
# anything else, including unset, means every order is Cash on Delivery
# and Stripe is never called.
PAYMENT_GATEWAY_ENABLED=false

# A card order reserves its stock the moment it's created; if the customer
# never completes payment, this is how many minutes the abandoned-order
# sweep waits before releasing that stock back to sellable inventory.
CHECKOUT_ABANDONED_ORDER_TTL_MINUTES=30

# Matches docker-compose.yml's mailhog service — view sent mail at localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=GiftBuddy <orders@giftbuddy.test>

# Leave blank to disable image uploads in the admin console (the "Upload"
# button will show a clear error instead of the app failing to boot).
# Get these from your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Leave blank to disable phone+OTP sign-up/sign-in (the "Send Code" button
# will show a clear error instead of the app failing to boot).
# Get these from your Twilio console: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
